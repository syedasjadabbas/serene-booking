{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--watch-path=server/app.js",
        "--watch-path=server/server.js",
        "--watch-path=server/config",
        "--watch-path=server/lib",
        "--watch-path=server/middlewares",
        "--watch-path=server/modules",
        "server/server.js"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["client/node_modules/next/dist/bin/next", "dev", "client", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["client/node_modules/next/dist/bin/next", "start", "client", "-p", "3001"],
      "env": { "NEXT_DIST_DIR": ".next-prod" },
      "port": 3001
    }
  ]
}
