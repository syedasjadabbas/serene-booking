# Where Next.js proxies /api/v1 (the Express API).
#   Local:  http://localhost:4000
#   Vercel: the API project's URL, e.g. https://serene-booking-api.vercel.app   (REQUIRED on Vercel)
API_URL=http://localhost:4000

# Public URL of this website (share-preview images, canonical links).
# On Vercel it falls back to the project's production domain if unset.
SITE_URL=http://localhost:3000

# Shared secret with the API (same value as the API's PROXY_SECRET). Lets the API see real visitor IPs
# for rate limiting. Generate a long random string; leave empty locally.
PROXY_SECRET=
