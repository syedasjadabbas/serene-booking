# Base path. The website is served inside the Serene Heights Group site at /booking (Next.js Multi-Zones):
# sereneheightsgroup.com/booking/* is rewritten to this deployment. Leave unset for "/booking";
# set to an empty value only to run the site at its own root.
# NEXT_PUBLIC_BASE_PATH=/booking

# The group site (footer "Serene Heights Group" link). "/" is right when served inside it.
# NEXT_PUBLIC_GROUP_URL=/

# Where Next.js proxies {base path}/api/v1 (the Express API).
#   Local:  http://localhost:4000
#   Vercel: the API project's URL, e.g. https://serene-booking-api.vercel.app   (REQUIRED on Vercel)
API_URL=http://localhost:4000

# Public URL of this website including the base path, e.g. https://www.sereneheightsgroup.com/booking
# (share-preview images, canonical links).
# On Vercel it falls back to the project's production domain if unset.
SITE_URL=http://localhost:3000

# Shared secret with the API (same value as the API's PROXY_SECRET). Lets the API see real visitor IPs
# for rate limiting. Generate a long random string; leave empty locally.
PROXY_SECRET=
