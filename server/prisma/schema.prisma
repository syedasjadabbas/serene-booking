// Serene Booking: guest-facing booking for Serene Heights Nathia Gali.
// Admin (rates, inventory, booking ops) will live in Serene Management; it reads these tables / the Outbox.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  PAY_AT_PROPERTY
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model Customer {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  country      String?
  status       CustomerStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sessions Session[]
  bookings Booking[]
  reviews  Review[]
}

model Session {
  id               String    @id @default(cuid())
  customerId       String
  platform         String    @default("web")
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokeReason     String?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, platform, revokedAt])
}

model RoomType {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  description  String
  bedrooms     Int      @default(1)
  bathrooms    Int      @default(1)
  bedType      String
  outdoorSpace String
  maxAdults    Int
  maxChildren  Int
  maxOccupancy Int
  baseRate     Int // per room per night, in CURRENCY minor-less units (PKR)
  features     String[]
  images       String[]
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms         Room[]
  bookings      Booking[]
  seasonalRates SeasonalRate[]

  @@index([isActive, sortOrder])
}

model Room {
  id           String   @id @default(cuid())
  number       String   @unique
  floor        Int
  floorLabel   String
  areaSqft     Int?
  outdoorSpace String
  isActive     Boolean  @default(true)
  roomTypeId   String
  createdAt    DateTime @default(now())

  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  bookingRooms BookingRoom[]

  @@index([roomTypeId, isActive])
}

model RatePlan {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  description       String
  refundable        Boolean
  freeCancelHours   Int?
  breakfastIncluded Boolean  @default(false)
  breakfastPerGuest Int      @default(0)
  discountPercent   Int      @default(0)
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  bookings Booking[]

  @@index([isActive, sortOrder])
}

// Seasonal price multipliers (e.g. snow season). roomTypeId null = applies to all room types.
model SeasonalRate {
  id            String   @id @default(cuid())
  name          String
  roomTypeId    String?
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date // inclusive
  multiplierPct Int // 100 = base rate
  createdAt     DateTime @default(now())

  roomType RoomType? @relation(fields: [roomTypeId], references: [id])

  @@index([startDate, endDate])
}

model Booking {
  id               String        @id @default(cuid())
  reference        String        @unique
  customerId       String?
  roomTypeId       String
  ratePlanId       String
  checkIn          DateTime      @db.Date
  checkOut         DateTime      @db.Date
  nights           Int
  roomsCount       Int
  adults           Int
  children         Int
  status           BookingStatus @default(CONFIRMED)
  guestFirstName   String
  guestLastName    String
  guestEmail       String
  guestPhone       String
  guestCountry     String?
  arrivalTime      String?
  specialRequests  String?
  currency         String        @default("PKR")
  roomSubtotal     Int
  discountTotal    Int
  breakfastTotal   Int
  taxTotal         Int
  grandTotal       Int
  nightlyBreakdown Json
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(UNPAID)
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer     Customer?     @relation(fields: [customerId], references: [id])
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  ratePlan     RatePlan      @relation(fields: [ratePlanId], references: [id])
  bookingRooms BookingRoom[]
  review       Review?

  @@index([customerId, checkIn])
  @@index([guestEmail])
  @@index([status, checkIn])
  @@index([createdAt])
}

// One row per physical apartment held by a booking. A Postgres exclusion constraint
// (see migration) makes double-booking the same apartment for overlapping dates impossible.
model BookingRoom {
  id        String   @id @default(cuid())
  bookingId String
  roomId    String
  checkIn   DateTime @db.Date
  checkOut  DateTime @db.Date
  active    Boolean  @default(true)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id])

  @@index([roomId, checkIn, checkOut])
  @@index([bookingId])
}

model Review {
  id         String       @id @default(cuid())
  bookingId  String       @unique
  customerId String
  rating     Int
  title      String
  body       String
  status     ReviewStatus @default(PUBLISHED)
  createdAt  DateTime     @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorType String // customer | guest | system
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([entity, entityId])
}

// Outbound events for Serene Management (and later: email, payment gateway). Processed by a worker.
model Outbox {
  id          String    @id @default(cuid())
  topic       String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}
