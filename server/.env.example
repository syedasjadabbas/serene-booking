# Copy to .env and fill in. Never commit .env.
# On Vercel, set these in Project → Settings → Environment Variables instead (NODE_ENV is set automatically).
NODE_ENV=development
PORT=4000

# Postgres.
#   Local:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/serene_booking?schema=public&connection_limit=10
#   Vercel: the POOLED Neon URL with ?sslmode=require&pgbouncer=true&connection_limit=1
#           (run migrations from your machine with the DIRECT, non-pooled URL — see README "Deploy to Vercel")
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/serene_booking?schema=public&connection_limit=10

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# One active session per customer per platform (CRM convention). Set false to allow many browsers.
SINGLE_SESSION_PER_PLATFORM=true

# Browser origin allowed by CORS (the Next.js client). On Vercel: the website's URL.
# Comma-separated origins the website is served from (its own domain and the group site that hosts /booking)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3010
# Path of the refresh-token cookie. Must match where the browser sees auth calls: /booking/api/v1/auth
# while the website runs under /booking (default); /api/v1/auth if it runs at its root.
AUTH_COOKIE_PATH=/booking/api/v1/auth

# Shared secret with the website's proxy (same value as the website's PROXY_SECRET) so rate limits and
# audit logs use real visitor IPs. Required on Vercel; leave empty locally.
PROXY_SECRET=

# Optional. Leave empty to use the in-memory cache.
REDIS_URL=

# Pricing (placeholders: confirm with Serene Heights management)
CURRENCY=PKR
TAX_PERCENT=16
WEEKEND_UPLIFT_PERCENT=10
MAX_STAY_NIGHTS=30
MAX_ROOMS_PER_BOOKING=5

# Dev only: requests from this machine skip rate limits unless this is true. Production always limits.
RATE_LIMIT_LOCAL=false

# Feature flags
# Online payments are UI-only until a gateway is connected.
PAYMENTS_ENABLED=false
REVIEWS_ENABLED=true
