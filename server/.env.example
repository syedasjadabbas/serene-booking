# Copy to .env and fill in. Never commit .env.
# Local dev test account (created while testing the UI; local database only):
#   ui.tester@example.test / Serene-test-2026
NODE_ENV=development
PORT=4000

# Postgres (local service). Create the database first: CREATE DATABASE serene_booking;
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/serene_booking?schema=public&connection_limit=10

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# One active session per customer per platform (CRM convention). Set false to allow many browsers.
SINGLE_SESSION_PER_PLATFORM=true

# Browser origin allowed by CORS (the Next.js client)
CLIENT_ORIGIN=http://localhost:3000

# Optional. Leave empty to use the in-memory cache.
REDIS_URL=

# Pricing (placeholders: confirm with Serene Heights management)
CURRENCY=PKR
TAX_PERCENT=16
WEEKEND_UPLIFT_PERCENT=10
MAX_STAY_NIGHTS=30
MAX_ROOMS_PER_BOOKING=5

# Feature flags
# Online payments are UI-only until a gateway is connected.
PAYMENTS_ENABLED=false
REVIEWS_ENABLED=true
